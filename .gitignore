# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (don't commit these!)
venv/
ENV/
env/

# Data files & tokens (sensitive!)
data/token_store.json
data/*.db
data/*.pickle
data/*.pt
models/*.pt
models/*.onnx
models/*.*.index

