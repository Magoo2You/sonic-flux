logs/*.log

# IDE specific
.vscode/
.idea/
*.swp
*.swo
*~

# Environment variables file (use config files instead)
.env
.env.local

# Generated artifacts
playlists/
__pycache__/
*.egg-info/

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
tmp/
temp/
*.tmp
*.bak
